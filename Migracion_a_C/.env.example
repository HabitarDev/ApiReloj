API_PORT=8080
DB_NAME=apireloj
DB_USER=apireloj
DB_PASSWORD=change-me

# Credencial enviada por el backend en X-Api-Key.
BACKEND_API_KEY=replace-with-a-long-random-secret

# IP fija que la API observa como origen de las llamadas del backend.
BACKEND_ALLOWED_IP=203.0.113.20

# Credenciales usadas por ApiReloj para comunicarse con los relojes Hikvision.
ISAPI_USER=replace-with-isapi-user
ISAPI_PASSWORD=replace-with-isapi-password

# Habilitar solamente cuando la API está detrás de Traefik/Dokploy.
PROXY_ENABLED=false
PROXY_FORWARD_LIMIT=1
# Ejemplo; reemplazar por el CIDR real obtenido con docker network inspect.
PROXY_KNOWN_NETWORK=10.0.1.0/24

# Evita que cada deploy dispare ISAPI antes de completar los smokes.
BACKFILL_RUN_ON_STARTUP=false
