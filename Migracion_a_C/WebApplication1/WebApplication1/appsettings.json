{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=apireloj;Username=apireloj;Password=apireloj"
  },
  "Security": {
    "Backend": {
      "ApiKey": "",
      "AllowedIp": ""
    },
    "Heartbeat": {
      "AllowedClockSkewSeconds": 300,
      "MaximumBodySizeBytes": 8192,
      "PermitLimitPerIp": 600,
      "RateWindowSeconds": 60,
      "GlobalConcurrencyLimit": 200
    }
  },
  "JornadaProcessing": {
    "WorkerIntervalMinutes": 5,
    "WorkerIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxAttempts": 8,
    "RetryBaseSeconds": 5,
    "IncompleteTimeoutHours": 24,
    "AttendanceStatusMap": {
      "CheckIn": [ "checkIn" ],
      "BreakIn": [ "breakIn" ],
      "BreakOut": [ "breakOut" ],
      "CheckOut": [ "checkOut" ]
    }
  },
  "BackfillPolling": {
    "WorkerIntervalMinutes": 30,
    "WindowMinutes": 30,
    "MaxResultsPerPage": 30,
    "HttpTimeoutSeconds": 30,
    "RunOnStartup": true,
    "BootstrapStartUtc": "2000-01-01T00:00:00Z",
    "MaxWindowsPerRun": 5000
  }
}
