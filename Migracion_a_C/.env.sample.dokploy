# Variables runtime para pegar en Environment Settings del recurso Application.
# Dokploy construye el Dockerfile y no aplica los aliases de docker-compose.yml.

ASPNETCORE_ENVIRONMENT=Production

# Usar el hostname interno exacto entregado por el recurso PostgreSQL de Dokploy.
# No usar localhost: PostgreSQL se ejecuta en otro contenedor.
ConnectionStrings__Default=Host=REPLACE_WITH_DOKPLOY_POSTGRES_HOST;Port=5432;Database=apireloj;Username=apireloj;Password=replace-with-a-strong-database-password

# Contrato QUIEVO -> ApiReloj.
Security__Backend__ApiKey=replace-with-a-long-random-secret
Security__Backend__AllowedIp=203.0.113.20

# Traefik termina TLS. Reemplazar el CIDR por la subnet real de su red Docker.
Security__Proxy__Enabled=true
Security__Proxy__ForwardLimit=1
Security__Proxy__KnownNetworks__0=10.0.1.0/24

# ApiReloj -> relojes Hikvision. No son credenciales de QUIEVO.
ISAPI_USER=replace-with-isapi-user
ISAPI_PASSWORD=replace-with-isapi-password

# Mantener false durante el primer despliegue y los smokes de staging.
BackfillPolling__RunOnStartup=false

# El Dockerfile ya fija ASPNETCORE_URLS=http://+:8080.
# Configurar el target/container port 8080 en Dokploy.
# Device.SecretKey se aprovisiona por POST /Device y queda en PostgreSQL.
# No existe URL de callback: ApiReloj no realiza llamadas hacia QUIEVO.
