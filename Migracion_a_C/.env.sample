# Template para docker-compose.yml. Copiar como .env antes de usar Compose.
API_PORT=8080

# PostgreSQL ejecutado en el host accesible desde el contenedor.
DB_NAME=apireloj
DB_USER=apireloj
DB_PASSWORD=replace-with-a-strong-database-password

# Credencial enviada por QUIEVO en X-Api-Key.
BACKEND_API_KEY=replace-with-a-long-random-secret

# IP fija que ApiReloj debe observar como origen de QUIEVO.
BACKEND_ALLOWED_IP=203.0.113.20

# Credenciales usadas por ApiReloj para comunicarse con los relojes Hikvision.
ISAPI_USER=replace-with-isapi-user
ISAPI_PASSWORD=replace-with-isapi-password

# En ejecución local directa se mantiene deshabilitado.
PROXY_ENABLED=false
PROXY_FORWARD_LIMIT=1

# Reemplazar por el CIDR real sólo si este Compose queda detrás de un proxy.
PROXY_KNOWN_NETWORK=10.0.1.0/24

# Evita disparar llamadas ISAPI automáticamente durante arranque y smoke.
BACKFILL_RUN_ON_STARTUP=false
